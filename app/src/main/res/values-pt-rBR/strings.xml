<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- app_name is not translated (defined in the default strings.xml as "BarCalc"). -->

    <!-- Moeda: símbolo prefixado em cada valor. -->
    <string name="currency_symbol">R$</string>

    <!-- Tela 1: Itens -->
    <string name="items_title">Comanda</string>
    <string name="items_subtitle">Adicione cada item da comanda</string>
    <string name="item_name_hint">Nome do item</string>
    <!-- Sufixo após o campo de preço no card de adicionar item, ex.: "R$ 0,00 cada" -->
    <string name="price_each_suffix">cada</string>
    <string name="items_empty">Nenhum item ainda — adicione a primeira rodada acima.</string>
    <string name="subtotal">Subtotal</string>
    <string name="next">Avançar</string>
    <string name="add_item_disabled_hint">Adicione ao menos um item para continuar</string>
    <string name="cd_add_item">Adicionar item</string>
    <string name="cd_remove_item">Remover item</string>

    <!-- Tela 2: Pessoas -->
    <string name="people_title">Quem vai dividir?</string>
    <string name="people_subtitle">Toque em uma pessoa para atribuir os itens</string>
    <string name="person_name_hint">Nome da pessoa</string>
    <string name="people_empty">Ninguém adicionado ainda — adicione a primeira pessoa acima.</string>
    <string name="cd_add_person">Adicionar pessoa</string>
    <string name="cd_remove_person">Remover pessoa</string>
    <string name="no_items_assigned">Nenhum item atribuído ainda</string>
    <string name="add_tip">Adicionar gorjeta</string>
    <string name="tip_percent">%1$d%%</string>
    <string name="calculate">Calcular</string>
    <string name="unclaimed_banner">Ainda falta atribuir: %1$s</string>
    <!-- ex.: "Cerveja (2 restantes)" — item com unidades sem dono -->
    <string name="unclaimed_item_partial">%1$s (%2$d restantes)</string>

    <!-- contagem de itens · valor gasto, sob o nome de cada pessoa -->
    <plurals name="claim_summary" tools:ignore="MissingQuantity">
        <item quantity="one">%1$d item · %2$s</item>
        <item quantity="other">%1$d itens · %2$s</item>
    </plurals>

    <!-- Folha de atribuição -->
    <!-- Exibida quando algum item tem mais de uma unidade, ou seja, há chips numerados na tela. -->
    <string name="claim_instructions_units">Toque num número para entrar naquela unidade — compartilhar uma com alguém divide o custo.</string>
    <!-- Exibida quando todos os itens têm uma única unidade, ou seja, só há caixas de seleção. -->
    <string name="claim_instructions_items">Marque o que esta pessoa consumiu — compartilhar um item com alguém divide o custo.</string>
    <!-- Chip que atribui/remove todas as unidades de um item de uma vez -->
    <string name="claim_all">Todas</string>
    <string name="unit_price_each">%1$s cada</string>
    <string name="done">Concluir</string>
    <string name="cancel">Cancelar</string>
    <string name="reset_confirm_title">Começar uma nova conta?</string>
    <string name="reset_confirm_message">Isso apaga a conta atual — itens, pessoas e o que cada um pediu. Ela é salva no seu histórico antes, então você pode começar de novo a partir dela.</string>
    <string name="reset_confirm_confirm">Começar nova</string>
    <string name="cd_close">Fechar</string>
    <string name="cd_back">Voltar</string>

    <!-- Drawer -->
    <string name="cd_menu">Menu</string>
    <string name="menu_title">Menu</string>
    <string name="menu_history">Histórico</string>
    <string name="menu_about">Sobre</string>

    <!-- History -->
    <string name="history_title">Histórico</string>
    <string name="history_subtitle">As contas concluídas ficam salvas aqui.</string>
    <string name="history_empty">Nenhuma conta salva ainda. Quando você concluir uma conta, ela aparece aqui.</string>
    <string name="history_clear_all">Limpar tudo</string>
    <string name="history_entry_summary">%1$d itens · %2$d pessoas</string>
    <string name="cd_rename_entry">Renomear</string>
    <string name="cd_delete_entry">Excluir</string>
    <string name="history_duplicate_hint">Toque em uma conta para começar uma nova a partir dela.</string>

    <!-- History dialogs -->
    <string name="history_replace_title">Substituir a conta atual?</string>
    <string name="history_replace_message">Você tem uma conta em andamento. Começar a partir desta conta salva vai descartá-la.</string>
    <string name="history_replace_confirm">Substituir</string>
    <string name="history_rename_title">Dê um nome a esta conta</string>
    <string name="history_rename_placeholder">ex.: Sexta no Zé</string>
    <string name="history_rename_confirm">Salvar</string>
    <string name="history_delete_title">Excluir esta conta?</string>
    <string name="history_delete_message">Esta conta salva será removida definitivamente.</string>
    <string name="history_delete_confirm">Excluir</string>
    <string name="history_clear_title">Limpar todo o histórico?</string>
    <string name="history_clear_message">Todas as contas salvas serão removidas definitivamente. Não dá para desfazer.</string>
    <string name="history_clear_confirm">Limpar tudo</string>

    <!-- Tela 3: Resultado -->
    <string name="results_title">Veja a divisão</string>
    <string name="results_subtitle">%1$s · Total %2$s</string>
    <!-- Exibida no lugar de results_subtitle quando a gorjeta está ativa: %2$s = total da comanda sem gorjeta, %3$s = total com gorjeta -->
    <string name="results_subtitle_with_tip">%1$s · Subtotal %2$s · Total (com gorjeta) %3$s</string>
    <string name="tip_share">Parte da gorjeta</string>
    <string name="result_line_item">%1$s ×%2$d</string>
    <string name="result_line_item_shared">%1$s ×%2$d (compartilhado)</string>
    <string name="cd_expand">Expandir</string>
    <string name="cd_collapse">Recolher</string>

    <plurals name="people_count" tools:ignore="MissingQuantity">
        <item quantity="one">%1$d pessoa</item>
        <item quantity="other">%1$d pessoas</item>
    </plurals>

    <!-- Componentes compartilhados -->
    <string name="cd_decrease">Diminuir</string>
    <string name="cd_increase">Aumentar</string>

    <!-- Sobre -->
    <string name="about_title">Sobre</string>
    <string name="about_version">Versão %1$s</string>
    <string name="close">Fechar</string>
    <string name="about_description">O BarCalc ajuda um grupo a dividir a conta do bar de forma justa — item por item, até o último centavo. Adicione cada item, adicione quem vai dividir e toque para atribuir o que cada um consumiu; compartilhar uma unidade divide o custo entre eles. Adicione a gorjeta e cada um recebe seu próprio total exato, com a gorjeta dividida na proporção do que pediu.</string>
    <string name="about_privacy">Tudo fica no seu dispositivo — sem cadastro, sem anúncios, sem rastreamento, sem internet.</string>
    <string name="about_developer">Concebido e dirigido por Pedro Henrique Flores. Seu design visual foi elaborado com o Claude Design, e o app foi construído com o Claude Code — o agente de programação por IA da Anthropic.</string>
    <string name="about_open_source">Este app é de código aberto — veja o código no GitHub:</string>
    <string name="about_report_issue">Relatar um problema</string>
    <string name="about_licenses_heading">Licenças de código aberto</string>
    <string name="about_licenses_body">As fontes Caprasimo (© 2023) e Figtree (© 2022) são usadas sob a SIL Open Font License 1.1.</string>
</resources>
